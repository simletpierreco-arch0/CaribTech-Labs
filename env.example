# ==============================================================
# CaribTech Labs - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit your real ".env" file to GitHub.
# ==============================================================

# Flask secret key - used to sign sessions/cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Flask environment: "development" or "production"
FLASK_ENV=development

# Database connection (SQLite by default)
DATABASE_URL=sqlite:///database/caribtech.db

# Max upload size in MB
MAX_UPLOAD_MB=10

# Session cookie lifetime in minutes
SESSION_LIFETIME_MINUTES=60

# Rate limiting storage (in-memory by default; use redis:// in production)
RATELIMIT_STORAGE_URI=memory://
